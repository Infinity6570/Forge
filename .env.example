# Copy this file to .env. Enter your key in the app's Settings page on localhost
# or edit this local file directly. Never commit .env or share it.
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-4.1-mini
GEMINI_FALLBACK_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# BenchLM Data API: Forge also accepts the documented BENCHLM_DATA_KEY name.
BENCHLM_API_KEY=
RUN_LOCAL_CODE=false
RUN_LOCAL_APP_PREVIEWS=false
FORGE_MAX_TOOL_ROUNDS=40
